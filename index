<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aula de Tesis | Asesoría de Tesis y Metodología de Investigación</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Font: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f9f6f8',
                            100: '#f0e8f1',
                            500: '#C9A88C',
                            600: '#432F48',
                            700: '#332338',
                            900: '#211624',
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased selection:bg-brand-500 selection:text-white">

    <header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-slate-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <a href="#" class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-brand-600 flex items-center justify-center text-white shadow-lg shadow-brand-500/30">
                    <i class="fa-solid fa-graduation-cap text-xl"></i>
                </div>
                <div>
                    <span class="text-xl font-extrabold text-slate-900 tracking-tight">Aula de <span class="text-brand-600">Tesis</span></span>
                    <span class="block text-[10px] uppercase font-bold text-slate-400 tracking-widest">Asesoría Académica</span>
                </div>
            </a>

            <!-- Navegación Escritorio -->
            <nav class="hidden lg:flex items-center space-x-7 text-sm font-semibold text-slate-600">
                <a href="#diagnostico" class="hover:text-brand-600 transition-colors">Test Diagnóstico</a>
                <a href="#agenda" class="hover:text-brand-600 transition-colors">Agendar Cita</a>
                <a href="#calculadora" class="hover:text-brand-600 transition-colors">Precios</a>
                <a href="#evaluador" class="hover:text-brand-600 transition-colors">Evaluador IA</a>
                <a href="#testimonios" class="hover:text-brand-600 transition-colors">Testimonios</a>
                <a href="#faq" class="hover:text-brand-600 transition-colors">Preguntas</a>
            </nav>

            <div class="flex items-center space-x-3">
                <button onclick="toggleCRMModal()" class="px-3.5 py-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold flex items-center space-x-2 transition-all">
                    <i class="fa-solid fa-chart-line text-brand-600"></i>
                    <span class="hidden sm:inline">Panel CRM (Demo)</span>
                </button>
                <a href="#agenda" class="px-4 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs sm:text-sm shadow-md shadow-brand-600/20 transition-all hover:-translate-y-0.5">
                    Reservar Diagnóstico
                </a>
            </div>
        </div>
    </header>

    <section class="relative py-16 lg:py-24 overflow-hidden bg-gradient-to-b from-brand-50/50 to-slate-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
                    <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-brand-100/80 text-brand-700 text-xs font-bold uppercase tracking-wider">
                        <i class="fa-solid fa-shield-halved text-brand-600"></i>
                        <span>Acompañamiento 100% Garantizado</span>
                    </div>
                    <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
                        Supera las Observaciones y <span class="text-brand-600 underline decoration-brand-500/30">Titúlate sin Estrés</span>
                    </h1>
                    <p class="text-base sm:text-lg text-slate-600 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
                        Acompañamiento metodológico especializado para estudiantes de Licenciatura, Maestría y Doctorado. Resolvemos desde la formulación del problema hasta el Análisis de Datos y la defensa final.
                    </p>
                    <div class="pt-2 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
                        <a href="#diagnostico" class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm shadow-lg shadow-brand-600/30 text-center transition-all hover:-translate-y-0.5">
                            <i class="fa-solid fa-list-check mr-2"></i> Evaluar Mi Tesis Gratis
                        </a>
                        <a href="#agenda" class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-white hover:bg-slate-100 text-slate-700 border border-slate-300 font-bold text-sm text-center shadow-sm transition-all">
                            <i class="fa-solid fa-calendar-check mr-2 text-brand-600"></i> Agendar Directo
                        </a>
                    </div>
                    <div class="pt-6 grid grid-cols-3 gap-4 border-t border-slate-200/80 max-w-lg mx-auto lg:mx-0">
                        <div>
                            <span class="block text-xl sm:text-2xl font-extrabold text-slate-900">+500</span>
                            <span class="text-xs text-slate-500 font-medium">Tesistas Guiados</span>
                        </div>
                        <div>
                            <span class="block text-xl sm:text-2xl font-extrabold text-slate-900">98%</span>
                            <span class="text-xs text-slate-500 font-medium">Tesis Aprobadas</span>
                        </div>
                        <div>
                            <span class="block text-xl sm:text-2xl font-extrabold text-slate-900">100%</span>
                            <span class="text-xs text-slate-500 font-medium">Rigor Académico</span>
                        </div>
                    </div>
                </div>

                <div class="lg:col-span-5 flex justify-center">
                    <div class="relative w-full max-w-md bg-white p-6 sm:p-8 rounded-3xl border border-slate-200/80 shadow-xl">
                        <div class="flex items-center space-x-3 mb-6">
                            <div class="w-12 h-12 rounded-2xl bg-amber-100 flex items-center justify-center text-amber-600 text-xl font-bold">
                                <i class="fa-solid fa-lightbulb"></i>
                            </div>
                            <div>
                                <h3 class="font-bold text-slate-900 text-base">¿Estancado en tu Tesis?</h3>
                                <p class="text-xs text-slate-500">Identifica tu nivel de bloqueo hoy</p>
                            </div>
                        </div>
                        <ul class="space-y-3.5 text-xs text-slate-600">
                            <li class="flex items-start space-x-3 bg-slate-50 p-3 rounded-xl border border-slate-100">
                                <i class="fa-solid fa-circle-check text-emerald-500 text-sm mt-0.5"></i>
                                <span>Revisión de observaciones de jurados y tutores.</span>
                            </li>
                            <li class="flex items-start space-x-3 bg-slate-50 p-3 rounded-xl border border-slate-100">
                                <i class="fa-solid fa-circle-check text-emerald-500 text-sm mt-0.5"></i>
                                <span>Estructuración de marco metodológico e hipótesis.</span>
                            </li>
                            <li class="flex items-start space-x-3 bg-slate-50 p-3 rounded-xl border border-slate-100">
                                <i class="fa-solid fa-circle-check text-emerald-500 text-sm mt-0.5"></i>
                                <span>Procesamiento de datos estadísticos.</span>
                            </li>
                            <li class="flex items-start space-x-3 bg-slate-50 p-3 rounded-xl border border-slate-100">
                                <i class="fa-solid fa-circle-check text-emerald-500 text-sm mt-0.5"></i>
                                <span>Simulacros intensivos para sustentación oral.</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="diagnostico" class="py-16 bg-white border-t border-slate-200">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-10">
                <span class="text-xs font-bold tracking-wider text-brand-600 uppercase">Evaluación Gratuita</span>
                <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-1">Test Diagnóstico de Investigación</h2>
                <p class="text-slate-600 text-sm mt-2">Responde 4 preguntas breves para calcular el nivel de riesgo de tu proyecto.</p>
            </div>

            <div class="bg-slate-50 p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-sm">
                <!-- Barra de Progreso -->
                <div class="mb-8">
                    <div class="flex justify-between text-xs font-bold text-slate-500 mb-2">
                        <span id="wizard-step-label">Paso 1 de 4</span>
                        <span id="wizard-progress-percent">25%</span>
                    </div>
                    <div class="w-full h-2.5 bg-slate-200 rounded-full overflow-hidden">
                        <div id="wizard-progress-bar" class="h-full bg-brand-600 transition-all duration-300 w-1/4"></div>
                    </div>
                </div>

                <!-- Formulario Multipaso -->
                <form id="diagnostic-form" onsubmit="event.preventDefault();">
                    <!-- Paso 1 -->
                    <div id="step-1" class="space-y-4">
                        <h3 class="text-base font-bold text-slate-800">1. ¿Qué grado o nivel académico estás cursando?</h3>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                            <label class="cursor-pointer border-2 border-slate-200 p-4 rounded-xl bg-white hover:border-brand-500 transition-all flex flex-col items-center text-center">
                                <input type="radio" name="nivel" value="Pregrado / Licenciatura" class="sr-only" onchange="nextStep(2)">
                                <i class="fa-solid fa-user-graduate text-2xl text-brand-600 mb-2"></i>
                                <span class="font-bold text-xs text-slate-800">Pregrado / Licenciatura</span>
                            </label>
                            <label class="cursor-pointer border-2 border-slate-200 p-4 rounded-xl bg-white hover:border-brand-500 transition-all flex flex-col items-center text-center">
                                <input type="radio" name="nivel" value="Maestría / Posgrado" class="sr-only" onchange="nextStep(2)">
                                <i class="fa-solid fa-award text-2xl text-brand-600 mb-2"></i>
                                <span class="font-bold text-xs text-slate-800">Maestría / Posgrado</span>
                            </label>
                            <label class="cursor-pointer border-2 border-slate-200 p-4 rounded-xl bg-white hover:border-brand-500 transition-all flex flex-col items-center text-center">
                                <input type="radio" name="nivel" value="Doctorado / PhD" class="sr-only" onchange="nextStep(2)">
                                <i class="fa-solid fa-book-bookmark text-2xl text-brand-600 mb-2"></i>
                                <span class="font-bold text-xs text-slate-800">Doctorado / PhD</span>
                            </label>
                        </div>
                    </div>

                    <!-- Paso 2 -->
                    <div id="step-2" class="hidden space-y-4">
                        <h3 class="text-base font-bold text-slate-800">2. ¿En qué estado se encuentra tu tesis actualmente?</h3>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <label class="cursor-pointer border-2 border-slate-200 p-4 rounded-xl bg-white hover:border-brand-500 transition-all flex items-center space-x-3">
                                <input type="radio" name="estado" value="Idea o Perfil Inicial" class="sr-only" onchange="nextStep(3)">
                                <i class="fa-solid fa-compass text-brand-600 text-xl"></i>
                                <span class="font-bold text-xs text-slate-800">Idea o Perfil Inicial</span>
                            </label>
                            <label class="cursor-pointer border-2 border-slate-200 p-4 rounded-xl bg-white hover:border-brand-500 transition-all flex items-center space-x-3">
                                <input type="radio" name="estado" value="Marco Teórico / Metodología" class="sr-only" onchange="nextStep(3)">
                                <i class="fa-solid fa-file-pen text-brand-600 text-xl"></i>
                                <span class="font-bold text-xs text-slate-800">Marco Teórico / Metodología</span>
                            </label>
                            <label class="cursor-pointer border-2 border-slate-200 p-4 rounded-xl bg-white hover:border-brand-500 transition-all flex items-center space-x-3">
                                <input type="radio" name="estado" value="Análisis y Procesamiento de Datos" class="sr-only" onchange="nextStep(3)">
                                <i class="fa-solid fa-chart-pie text-brand-600 text-xl"></i>
                                <span class="font-bold text-xs text-slate-800">Análisis y Procesamiento de Datos</span>
                            </label>
                            <label class="cursor-pointer border-2 border-slate-200 p-4 rounded-xl bg-white hover:border-brand-500 transition-all flex items-center space-x-3">
                                <input type="radio" name="estado" value="Observaciones de Jurado" class="sr-only" onchange="nextStep(3)">
                                <i class="fa-solid fa-circle-exclamation text-amber-500 text-xl"></i>
                                <span class="font-bold text-xs text-slate-800">Observaciones de Jurado</span>
                            </label>
                        </div>
                    </div>

                    <!-- Paso 3 -->
                    <div id="step-3" class="hidden space-y-4">
                        <h3 class="text-base font-bold text-slate-800">3. ¿Cuál es tu obstáculo principal en este momento?</h3>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <label class="cursor-pointer border-2 border-slate-200 p-4 rounded-xl bg-white hover:border-brand-500 transition-all flex items-center space-x-3">
                                <input type="radio" name="obstaculo" value="No sé cómo plantear la hipótesis/variables" class="sr-only" onchange="nextStep(4)">
                                <span class="font-bold text-xs text-slate-800">Planteamiento de Hipótesis/Variables</span>
                            </label>
                            <label class="cursor-pointer border-2 border-slate-200 p-4 rounded-xl bg-white hover:border-brand-500 transition-all flex items-center space-x-3">
                                <input type="radio" name="obstaculo" value="Dificultad con Análisis cuantitativo o cualitativo" class="sr-only" onchange="nextStep(4)">
                                <span class="font-bold text-xs text-slate-800">Análisis Estadístico</span>
                            </label>
                            <label class="cursor-pointer border-2 border-slate-200 p-4 rounded-xl bg-white hover:border-brand-500 transition-all flex items-center space-x-3">
                                <input type="radio" name="obstaculo" value="Formato de citas APA / Redacción técnica" class="sr-only" onchange="nextStep(4)">
                                <span class="font-bold text-xs text-slate-800">Formato APA / Normativa</span>
                            </label>
                            <label class="cursor-pointer border-2 border-slate-200 p-4 rounded-xl bg-white hover:border-brand-500 transition-all flex items-center space-x-3">
                                <input type="radio" name="obstaculo" value="Falta de tiempo y guía personalizada" class="sr-only" onchange="nextStep(4)">
                                <span class="font-bold text-xs text-slate-800">Falta de Tiempo / Acompañamiento</span>
                            </label>
                        </div>
                    </div>

                    <!-- Paso 4 -->
                    <div id="step-4" class="hidden space-y-4">
                        <h3 class="text-base font-bold text-slate-800">4. ¿Cuál es la fecha límite estimada para entregar o sustentar?</h3>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                            <label class="cursor-pointer border-2 border-slate-200 p-4 rounded-xl bg-white hover:border-brand-500 transition-all flex flex-col items-center text-center">
                                <input type="radio" name="plazo" value="Urgente (Menos de 1 mes)" class="sr-only" onchange="finishDiagnostic()">
                                <i class="fa-solid fa-hourglass-half text-rose-500 text-xl mb-1"></i>
                                <span class="font-bold text-xs text-slate-800">Urgente (&lt; 1 mes)</span>
                            </label>
                            <label class="cursor-pointer border-2 border-slate-200 p-4 rounded-xl bg-white hover:border-brand-500 transition-all flex flex-col items-center text-center">
                                <input type="radio" name="plazo" value="Medio plazo (1 a 3 meses)" class="sr-only" onchange="finishDiagnostic()">
                                <i class="fa-solid fa-clock text-amber-500 text-xl mb-1"></i>
                                <span class="font-bold text-xs text-slate-800">1 a 3 meses</span>
                            </label>
                            <label class="cursor-pointer border-2 border-slate-200 p-4 rounded-xl bg-white hover:border-brand-500 transition-all flex flex-col items-center text-center">
                                <input type="radio" name="plazo" value="Flexible (Más de 3 meses)" class="sr-only" onchange="finishDiagnostic()">
                                <i class="fa-solid fa-calendar-days text-emerald-500 text-xl mb-1"></i>
                                <span class="font-bold text-xs text-slate-800">&gt; 3 meses</span>
                            </label>
                        </div>
                    </div>
                </form>

                <div id="diagnostic-result" class="hidden space-y-5 pt-2">
                    <div class="p-5 rounded-2xl bg-brand-50 border border-brand-100 flex items-start space-x-4">
                        <div class="w-10 h-10 rounded-xl bg-brand-600 text-white flex items-center justify-center shrink-0 text-lg font-bold">
                            <i class="fa-solid fa-square-check"></i>
                        </div>
                        <div>
                            <h4 class="font-extrabold text-slate-900 text-base">Diagnóstico Finalizado con Éxito</h4>
                            <p id="risk-assessment-text" class="text-xs text-slate-600 mt-1 leading-relaxed">
                                Evaluando respuestas...
                            </p>
                        </div>
                    </div>
                    <div class="flex justify-center">
                        <button type="button" onclick="scrollAndFocusAgenda()" class="px-6 py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs sm:text-sm shadow-md transition-all flex items-center">
                            <span>Continuar a Agendar Cita con este Diagnóstico</span>
                            <i class="fa-solid fa-arrow-right ml-2"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="agenda" class="py-16 bg-slate-50 border-t border-slate-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-2xl mx-auto mb-12">
                <span class="text-xs font-bold tracking-wider text-brand-600 uppercase">Reserva Directa</span>
                <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-1">Agendar Sesión Diagnóstica Gratuita</h2>
                <p class="text-slate-600 text-sm mt-2">Selecciona la fecha y hora disponible. Tu confirmación se transmitirá directamente a WhatsApp.</p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                <!-- Calendario Interactivo -->
                <div class="lg:col-span-6 bg-white p-6 rounded-3xl border border-slate-200 shadow-sm space-y-6">
                    <div class="flex items-center justify-between pb-4 border-b border-slate-100">
                        <h3 id="calendar-month-year" class="font-extrabold text-slate-800 text-base">Mes Año</h3>
                        <div class="flex space-x-2">
                            <button onclick="changeMonth(-1)" class="w-8 h-8 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition-all">
                                <i class="fa-solid fa-chevron-left text-xs"></i>
                            </button>
                            <button onclick="changeMonth(1)" class="w-8 h-8 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition-all">
                                <i class="fa-solid fa-chevron-right text-xs"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Días de la Semana -->
                    <div class="grid grid-cols-7 gap-1 text-center text-[11px] font-bold text-slate-400 uppercase">
                        <div>Lun</div><div>Mar</div><div>Mié</div><div>Jue</div><div>Vie</div><div>Sáb</div><div>Dom</div>
                    </div>

                    <!-- Grilla de Días -->
                    <div id="calendar-days-grid" class="grid grid-cols-7 gap-1.5 text-xs">
                        <!-- Días generados por JavaScript -->
                    </div>

                    <!-- Bloque de Horarios -->
                    <div class="pt-4 border-t border-slate-100 space-y-3">
                        <span class="text-xs font-bold text-slate-700 block">Horarios Disponibles para el Día Seleccionado:</span>
                        <div id="time-slots-container" class="grid grid-cols-3 gap-2">
                            <button type="button" onclick="selectTimeSlot('09:00 AM')" class="time-slot-btn p-2 rounded-xl border border-slate-200 text-xs font-semibold hover:border-brand-500 transition-all text-center">09:00 AM</button>
                            <button type="button" onclick="selectTimeSlot('11:00 AM')" class="time-slot-btn p-2 rounded-xl border border-slate-200 text-xs font-semibold hover:border-brand-500 transition-all text-center">11:00 AM</button>
                            <button type="button" onclick="selectTimeSlot('03:00 PM')" class="time-slot-btn p-2 rounded-xl border border-slate-200 text-xs font-semibold hover:border-brand-500 transition-all text-center">03:00 PM</button>
                            <button type="button" onclick="selectTimeSlot('05:00 PM')" class="time-slot-btn p-2 rounded-xl border border-slate-200 text-xs font-semibold hover:border-brand-500 transition-all text-center">05:00 PM</button>
                            <button type="button" onclick="selectTimeSlot('07:00 PM')" class="time-slot-btn p-2 rounded-xl border border-slate-200 text-xs font-semibold hover:border-brand-500 transition-all text-center">07:00 PM</button>
                        </div>
                    </div>
                </div>

                <!-- Formulario de Datos -->
                <div class="lg:col-span-6 bg-white p-6 rounded-3xl border border-slate-200 shadow-sm space-y-5">
                    <h3 class="font-bold text-slate-800 text-base flex items-center">
                        <i class="fa-solid fa-user-check text-brand-600 mr-2"></i> Datos del Estudiante
                    </h3>

                    <!-- Alerta de validación personalizada -->
                    <div id="booking-alert" class="hidden p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-xs font-medium flex items-center space-x-2">
                        <i class="fa-solid fa-circle-exclamation text-rose-500 text-sm shrink-0"></i>
                        <span id="booking-alert-msg">Por favor selecciona una fecha y hora.</span>
                    </div>

                    <form id="booking-form" onsubmit="handleBookingSubmit(event)" class="space-y-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">Nombre Completo *</label>
                            <input type="text" id="student-name" required placeholder="Ej. Ana María Torres" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none">
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-1">Teléfono / WhatsApp *</label>
                                <input type="tel" id="student-phone" required placeholder="+591 79931123" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-1">Universidad *</label>
                                <input type="text" id="student-university" required placeholder="Ej. Universidad Nacional" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none">
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">Carrera / Especialidad</label>
