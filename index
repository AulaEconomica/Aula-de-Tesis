    <script>
        /* ========================================================================
           CONFIGURACIÓN GLOBAL DE WHATSAPP Y ESTADO
           ======================================================================== */
        // Número de teléfono de destino (Bolivia +591 77531709)
        const MI_NUMERO_WHATSAPP = "59177531709";

        let diagnosticData = {};
        let selectedDate = null;
        let selectedTime = null;
        let currentDate = new Date();
        let crmLeads = [
            {
                fecha: "Hace 10 min",
                nombre: "Carla Mendoza",
                universidad: "UMSA",
                diagnostico: "Maestría - Observaciones Jurado",
                cita: "18 Nov, 03:00 PM"
            }
        ];

        /* ========================================================================
           LÓGICA DEL DIAGNÓSTICO WIZARD
           ======================================================================== */
        function nextStep(stepNumber) {
            for (let i = 1; i <= 4; i++) {
                document.getElementById(`step-${i}`).classList.add('hidden');
            }
            document.getElementById(`step-${stepNumber}`).classList.remove('hidden');

            const percent = stepNumber * 25;
            document.getElementById('wizard-step-label').textContent = `Paso ${stepNumber} de 4`;
            document.getElementById('wizard-progress-percent').textContent = `${percent}%`;
            document.getElementById('wizard-progress-bar').style.width = `${percent}%`;
        }

        function finishDiagnostic() {
            const form = document.getElementById('diagnostic-form');
            const formData = new FormData(form);

            diagnosticData = {
                nivel: formData.get('nivel') || 'No especificado',
                estado: formData.get('estado') || 'No especificado',
                obstaculo: formData.get('obstaculo') || 'No especificado',
                plazo: formData.get('plazo') || 'No especificado'
            };

            for (let i = 1; i <= 4; i++) {
                document.getElementById(`step-${i}`).classList.add('hidden');
            }

            document.getElementById('diagnostic-result').classList.remove('hidden');
            document.getElementById('wizard-step-label').textContent = 'Paso 4 de 4 - Completado';
            document.getElementById('wizard-progress-percent').textContent = '100%';
            document.getElementById('wizard-progress-bar').style.width = '100%';

            document.getElementById('risk-assessment-text').innerHTML = `
                <strong>Nivel detectado:</strong> Nivel ${diagnosticData.nivel} | <strong>Fase:</strong> ${diagnosticData.estado}.<br>
                <strong>Atención Prioritaria:</strong> Requieres alineamiento en <em>${diagnosticData.obstaculo}</em> con margen de entrega <em>${diagnosticData.plazo}</em>.
            `;

            // Auto-llenar el campo de observaciones en el formulario de la cita
            populateStudentNotesFromDiagnostic();
        }

        function populateStudentNotesFromDiagnostic() {
            const notesField = document.getElementById('student-notes');
            if (notesField) {
                if (diagnosticData.nivel && diagnosticData.nivel !== 'No especificado') {
                    notesField.value = `[DIAGNÓSTICO PREVIO INTEGRADO]\n` +
                        `• Nivel Académico: ${diagnosticData.nivel}\n` +
                        `• Estado de la Tesis: ${diagnosticData.estado}\n` +
                        `• Obstáculo Principal: ${diagnosticData.obstaculo}\n` +
                        `• Plazo Estimado: ${diagnosticData.plazo}`;
                } else {
                    notesField.value = "Prefiero detallar mis observaciones y estado actual en la llamada.";
                }
            }
        }

        function scrollAndFocusAgenda() {
            populateStudentNotesFromDiagnostic();
            const agendaSec = document.getElementById('agenda');
            if (agendaSec) {
                agendaSec.scrollIntoView({ behavior: 'smooth' });
            }
            setTimeout(() => {
                const nameInput = document.getElementById('student-name');
                if (nameInput) nameInput.focus();
            }, 500);
        }

        function renderCalendar() {
            const monthYearText = document.getElementById('calendar-month-year');
            const daysGrid = document.getElementById('calendar-days-grid');
            if (!monthYearText || !daysGrid) return;

            const year = currentDate.getFullYear();
            const month = currentDate.getMonth();

            const monthNames = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];
            monthYearText.textContent = `${monthNames[month]} ${year}`;

            daysGrid.innerHTML = '';

            const firstDay = new Date(year, month, 1).getDay();
            const adjustedFirstDay = (firstDay === 0) ? 6 : firstDay - 1; 
            const totalDays = new Date(year, month + 1, 0).getDate();

            for (let i = 0; i < adjustedFirstDay; i++) {
                const emptyCell = document.createElement('div');
                daysGrid.appendChild(emptyCell);
            }

            const today = new Date();
            today.setHours(0, 0, 0, 0);

            for (let day = 1; day <= totalDays; day++) {
                const dayBtn = document.createElement('button');
                dayBtn.type = 'button';
                dayBtn.textContent = day;
                dayBtn.className = 'p-2 rounded-xl border border-slate-200 hover:border-brand-500 hover:bg-brand-50 transition-all font-semibold day-btn text-center';

                const thisDate = new Date(year, month, day);
                if (thisDate < today) {
                    dayBtn.disabled = true;
                    dayBtn.className = 'p-2 rounded-xl text-slate-300 cursor-not-allowed text-center';
                } else {
                    dayBtn.onclick = () => selectCalendarDay(day, monthNames[month], year, dayBtn);
                }

                daysGrid.appendChild(dayBtn);
            }
        }

        function changeMonth(offset) {
            currentDate.setMonth(currentDate.getMonth() + offset);
            renderCalendar();
        }

        function selectCalendarDay(day, monthName, year, btnElement) {
            document.querySelectorAll('.day-btn').forEach(b => b.classList.remove('bg-brand-600', 'text-white', 'border-brand-600'));
            btnElement.classList.add('bg-brand-600', 'text-white', 'border-brand-600');

            selectedDate = `${day} de ${monthName}, ${year}`;
            document.getElementById('summary-date').textContent = selectedDate;
            hideBookingAlert();
        }

        function selectTimeSlot(timeStr) {
            selectedTime = timeStr;
            document.querySelectorAll('.time-slot-btn').forEach(b => b.classList.remove('bg-brand-600', 'text-white', 'border-brand-600'));
            event.target.classList.add('bg-brand-600', 'text-white', 'border-brand-600');
            document.getElementById('summary-time').textContent = selectedTime;
            hideBookingAlert();
        }

        function showBookingAlert(message) {
            const alertBox = document.getElementById('booking-alert');
            const alertMsg = document.getElementById('booking-alert-msg');
            if (alertBox && alertMsg) {
                alertMsg.textContent = message;
                alertBox.classList.remove('hidden');
                alertBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }

        function hideBookingAlert() {
            const alertBox = document.getElementById('booking-alert');
            if (alertBox) alertBox.classList.add('hidden');
        }

        function handleBookingSubmit(e) {
            e.preventDefault();

            if (!selectedDate || !selectedTime) {
                showBookingAlert("Por favor selecciona una fecha y un horario disponible en el calendario.");
                return;
            }

            hideBookingAlert();

            const name = document.getElementById('student-name').value.trim();
            const phone = document.getElementById('student-phone').value.trim();
            const uni = document.getElementById('student-university').value.trim();
            const career = document.getElementById('student-career').value.trim();
            const notes = document.getElementById('student-notes').value.trim();

            // Registrar en CRM
            crmLeads.unshift({
                fecha: "Ahora",
                nombre: name,
                universidad: uni,
                diagnostico: diagnosticData.nivel ? `${diagnosticData.nivel} - ${diagnosticData.estado}` : "Sin test previo",
                cita: `${selectedDate} (${selectedTime})`
            });
            renderCRMTable();

            // Mensaje de WhatsApp estructurado
            let waMsg = `*RESERVA DE ASESORÍA DE TESIS*\n\n`;
            waMsg += `*Estudiante:* ${name}\n`;
            waMsg += `*Teléfono:* ${phone}\n`;
            waMsg += `*Universidad:* ${uni} (${career || 'Carrera N/D'})\n`;
            waMsg += `*Cita Solicitada:* ${selectedDate} a las ${selectedTime}\n\n`;

            if (diagnosticData.nivel) {
                waMsg += `*--- RESULTADOS DEL DIAGNÓSTICO ---*\n`;
                waMsg += `• Nivel: ${diagnosticData.nivel}\n`;
                waMsg += `• Estado actual: ${diagnosticData.estado}\n`;
                waMsg += `• Obstáculo: ${diagnosticData.obstaculo}\n`;
                waMsg += `• Plazo estimado: ${diagnosticData.plazo}\n\n`;
            }

            if (notes) {
                waMsg += `*Observaciones adicionales:*\n${notes}\n`;
            }

            const waUrl = `https://wa.me/${MI_NUMERO_WHATSAPP}?text=${encodeURIComponent(waMsg)}`;
            window.open(waUrl, '_blank');
        }

        function updatePriceCalculator() {
            const multiplier = parseFloat(document.getElementById('calc-level').value) || 1;
            const checkboxes = document.querySelectorAll('.calc-module:checked');
            let baseSum = 0;

            checkboxes.forEach(cb => {
                baseSum += parseFloat(cb.value);
            });

            const total = Math.round(baseSum * multiplier);
            document.getElementById('calc-total').textContent = `$${total} Bs.`;
        }

        function evaluateTitleAI() {
    const input = document.getElementById('ai-title-input').value.trim();
    if (!input) return;

    const resultsBox = document.getElementById('ai-results-box');
    resultsBox.classList.remove('hidden');

    // Normalizar texto para la búsqueda
    const upperInput = input.toUpperCase();

    // Listado de conectores que separan la Variable Independiente de la Variable Dependiente
    const connectors = [" PARA LA ", " PARA ", " Y SU INCIDENCIA EN ", " Y SU RELACIÓN CON ", " SOBRE ", " EN EL IMPACTO DE "];
    
    let var1 = "No identificada";
    let var2 = "No identificada";
    let delimitacion = "Requiere especificar ámbito/población";

    let splitIndex = -1;
    let usedConnector = "";

    // Buscar si el título contiene algún conector metodológico
    for (const connector of connectors) {
        splitIndex = upperInput.indexOf(connector);
        if (splitIndex !== -1) {
            usedConnector = connector;
            break;
        }
    }

    if (splitIndex !== -1) {
        // La Variable 1 es todo lo que está antes del conector
        var1 = input.substring(0, splitIndex).trim();

        // Lo que está después del conector contiene la Variable 2 y la delimitación
        const rest = input.substring(splitIndex + usedConnector.length).trim();

        // Buscar delimitadores de contexto/lugar (conectores como " EN ", " DE LA ", " CASO ")
        const contextConnectors = [" EN ESTUDIANTES ", " EN LA ", " EN EL ", " EN ", " CASO: "];
        let contextIndex = -1;
        let usedContextConn = "";

        const upperRest = rest.toUpperCase();
        for (const conn of contextConnectors) {
            contextIndex = upperRest.indexOf(conn);
            if (contextIndex !== -1) {
                usedContextConn = conn;
                break;
            }
        }

        if (contextIndex !== -1) {
            var2 = rest.substring(0, contextIndex).trim();
            delimitacion = rest.substring(contextIndex).trim();
        } else {
            var2 = rest;
        }
    } else {
        // Si no hay conectores claros, fallback ligero de palabras
        const words = input.split(' ');
        var1 = words.slice(0, Math.ceil(words.length / 2)).join(' ');
        var2 = words.slice(Math.ceil(words.length / 2)).join(' ');
    }

    // Actualizar el DOM
    document.getElementById('ai-var-1').textContent = var1 || "Variable 1";
    document.getElementById('ai-var-2').textContent = var2 || "Variable 2";
    document.getElementById('ai-delimit').textContent = delimitacion;

    document.getElementById('ai-feedback-text').innerHTML = `
        Estructura detectada correctamente. La propuesta plantea una relación de causa/efecto entre la variable de intervención (<strong>${var1}</strong>) y la variable de resultado (<strong>${var2}</strong>).
    `;
}

        function toggleCRMModal() {
            const modal = document.getElementById('crm-modal');
            modal.classList.toggle('hidden');
        }

        function renderCRMTable() {
            const tbody = document.getElementById('crm-table-body');
            if (!tbody) return;

            tbody.innerHTML = crmLeads.map(lead => `
                <tr>
                    <td class="p-2.5 font-medium">${lead.fecha}</td>
                    <td class="p-2.5 font-bold">${lead.nombre}</td>
                    <td class="p-2.5">${lead.universidad}</td>
                    <td class="p-2.5">${lead.diagnostico}</td>
                    <td class="p-2.5 font-bold text-brand-600">${lead.cita}</td>
                </tr>
            `).join('');
        }

        function clearCRMData() {
            crmLeads = [];
            renderCRMTable();
        }

        // Inicialización
        window.onload = function() {
            renderCalendar();
            renderCRMTable();
            updatePriceCalculator();
        };
    </script>
